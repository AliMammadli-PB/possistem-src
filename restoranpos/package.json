{
  "name": "possistem",
  "productName": "possistem",
  "version": "1.7.9",
  "description": "possistem restaurant POS (Electron + React + C++20 sidecar)",
  "author": "CyberPlus",
  "license": "UNLICENSED",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/fetch-deps.mjs",
    "dev": "node scripts/build-core.mjs --config Debug && node scripts/assemble-restaurant.mjs --allow-partial && electron .",
    "lint": "cd .. && restoranpos/node_modules/.bin/eslint -c restoranpos/eslint.config.mjs marketpos/electron restoranpos/scripts restoranpos/demo-web marketpos/demo-web",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && npm run market:typecheck",
    "build:core": "node scripts/build-core.mjs --config Release",
    "build:core:debug": "node scripts/build-core.mjs --config Debug",
    "build:desktop": "node scripts/assemble-restaurant.mjs",
    "build": "npm run typecheck && npm run build:core && npm run build:desktop",
    "test": "npm run test:core && npm run test:unit && npm run test:visuals",
    "test:core": "ctest --test-dir native/build --output-on-failure",
    "test:unit": "vitest run",
    "test:visuals": "node scripts/test-visual-assets.mjs",
    "test:fresh-db": "node scripts/test-fresh-db.mjs",
    "test:customer-bill": "node scripts/test-customer-bill.mjs",
    "test:catalog-ordering": "node scripts/test-catalog-ordering.mjs",
    "manifest:source": "node scripts/source-tree-manifest.mjs",
    "test:e2e": "playwright test",
    "package:win": "node scripts/package-win.mjs",
    "package:customer": "node scripts/package-customer.mjs",
    "publish:updates": "node scripts/setup-update-server.mjs --upload",
    "copy:installer": "node scripts/copy-installer-to-desktop.mjs",
    "clean": "node scripts/dev-clean.mjs",
    "fetch:assets": "node scripts/fetch-assets.mjs",
    "market:dev": "vite --config ../marketpos/vite.config.ts",
    "market:build": "vite build --config ../marketpos/vite.config.ts",
    "market:typecheck": "tsc --noEmit -p ../marketpos/tsconfig.json",
    "market:test": "vitest run tests/unit/market-pos-domain.test.ts",
    "market:package:win": "node scripts/package-market-win.mjs",
    "market:build:core": "node scripts/build-market-core.mjs",
    "market:test:core": "ctest --test-dir ../marketpos/native/build --output-on-failure",
    "test:admin-ui": "node scripts/qa-admin-refresh.mjs",
    "test:admin-forms": "node scripts/qa-admin-forms.mjs",
    "test:admin-destinations": "node scripts/qa-admin-destinations.mjs",
    "test:admin-real-pages": "node scripts/qa-admin-real-pages.mjs",
    "test:touch-receipt": "node scripts/qa-touch-receipt.mjs",
    "check:versions": "node scripts/check-versions.mjs"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.7.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jsqr": "^1.4.0",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.35.4",
    "ssh2": "^1.16.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "electron-updater": "^6.6.2",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "@xmldom/xmldom": "^0.8.15"
  }
}
