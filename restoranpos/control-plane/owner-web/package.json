{
  "name": "@milioner/owner-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:chat": "vite --config vite.config.chat.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:chat": "vite build --config vite.config.chat.ts && mv chat/chat.html chat/index.html && node ./scripts/fix-chat-html.mjs",
    "build:market": "vite build --config vite.config.market.ts && node ./scripts/fix-market-html.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.2.6",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "exceljs": "^4.4.0",
    "jsbarcode": "^3.12.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "@types/jsbarcode": "^3.11.4"
  }
}
