    "E_PIN_CHANGE_REQUIRED": {
      "retryable": false,
      "message": "The default PIN must be changed before signing in"
    },
    "E_MANAGER_APPROVAL_REQUIRED": {
      "retryable": false,
      "message": "This action requires manager approval"
    },
    "E_IDEMPOTENCY_KEY_REUSE": {
      "retryable": false,
      "message": "Idempotency key reused with a different payload"
    },
    "E_IN_PROGRESS": {
      "retryable": true,
      "message": "An identical request is still in progress"
