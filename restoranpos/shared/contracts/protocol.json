    "$comment.provisionIdentity": "Writes the restaurant's real name/address/phone/VOEN, learned from the control server at activation. auth:false because activation runs on the licence screen with nobody signed in; safe because the handler only overwrites values still equal to a factory seed default, so it can never rename a restaurant an operator has already named.",
    "settings.applyProvisionedIdentity": {
      "auth": false
    },
    "audit.list": {
      "auth": true,
      "perm": "audit.view"
    },
    "$comment.auditSync": "Read and acknowledge the forwarding queue. Both are auth:false because the owner sync loop in Electron main runs whether or not a cashier is signed in - gating them on a session would mean a till left at the login screen overnight forwards nothing, and the control panel's history would have holes exactly where an unattended machine was doing something worth seeing.",
    "audit.pending": {
      "auth": false
    },
    "audit.ack": {
      "auth": false
    },
