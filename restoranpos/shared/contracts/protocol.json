  "$eventComment": "Pushed from C++ to Electron main unsolicited (no requestId), then relayed to the renderer.",
  "events": {
    "core.ready": "Emitted once on stdout as the first frame after startup.",
    "core.stage": "Startup progress: { stage, message, progress }.",
    "core.alert": "Non-fatal condition needing user attention (low disk, printer down).",
    "core.fatal": "Unrecoverable condition; main drops to safe mode.",
    "kds.updated": "A kitchen job changed; payload carries the affected order ids.",
    "tables.updated": "One or more table statuses changed.",
    "orders.updated": "An order changed outside the caller's own request.",
    "print.updated": "A print job changed state.",
    "payment.needsReconciliation": "A payment entered or remains in the unknown state.",
