{
  "protocolVersion": 1,
  "$comment": "Single source of truth for the Electron <-> C++ IPC contract. scripts/gen-protocol.mjs generates shared/contracts/protocol.generated.ts and native/core/include/pos/protocol_generated.hpp from this file. Never hand-edit the generated files.",
  "limits": {
    "maxMessageBytes": 8388608,
    "maxInboundQueue": 256,
    "maxPendingRequests": 200,
    "defaultTimeoutMs": 3000,
    "handshakeTimeoutMs": 10000,
    "heartbeatIntervalMs": 5000,
    "heartbeatTimeoutMs": 2000,
    "heartbeatMissLimit": 3,
    "coreStallKillMs": 90000,
    "printTimeoutMs": 20000,
    "paymentTimeoutMs": 120000,
    "terminalTimeoutMs": 90000,
    "terminalAckTimeoutMs": 15000,
    "restartBackoffMs": [
      500,
      2000,
      5000
    ],
    "crashWindowMs": 60000,
    "crashStrikeLimit": 3
  },
  "errors": {
    "E_INTERNAL": {
      "retryable": false,
      "http": 500,
      "message": "Internal core error"
    },
    "E_INVALID_REQUEST": {
      "retryable": false,
      "message": "Malformed request envelope"
    },
    "E_UNKNOWN_METHOD": {
      "retryable": false,
      "message": "Unknown method"
    },
    "E_PROTOCOL_VERSION": {
      "retryable": false,
      "message": "Protocol version mismatch"
    },
    "E_PAYLOAD_TOO_LARGE": {
      "retryable": false,
      "message": "Payload exceeds maximum message size"
    },
    "E_QUEUE_FULL": {
      "retryable": true,
      "message": "Core request queue is full"
    },
    "E_TIMEOUT": {
      "retryable": true,
      "message": "Request timed out"
    },
    "E_CANCELED": {
      "retryable": false,
      "message": "Request was canceled"
    },
    "E_CORE_DOWN": {
      "retryable": true,
      "message": "POS core process is not running"
    },
    "E_CORE_UNAVAILABLE": {
      "retryable": true,
      "message": "POS core is starting up"
    },
    "E_CORE_MISSING": {
      "retryable": false,
      "message": "POS core executable was not found"
    },
    "E_CORE_INCOMPATIBLE": {
      "retryable": false,
      "message": "POS core version is incompatible"
    },
    "E_CRASH_LOOP": {
      "retryable": false,
      "message": "POS core is crash looping"
    },
    "E_DB_BUSY": {
      "retryable": true,
      "message": "Database is busy"
    },
    "E_DB_OPEN": {
      "retryable": false,
      "message": "Database could not be opened"
    },
    "E_DB_CORRUPT": {
      "retryable": false,
      "fatal": true,
      "message": "Database file is corrupt"
    },
    "E_DB_READONLY": {
      "retryable": false,
      "message": "Database is read only"
    },
    "E_DB_UNSUITABLE_LOCATION": {
      "retryable": false,
      "fatal": true,
      "message": "Database location does not support WAL journaling"
    },
    "E_DISK_FULL": {
      "retryable": false,
      "message": "Disk is full"
    },
    "E_CONSTRAINT": {
      "retryable": false,
      "message": "Database constraint violation"
    },
    "E_MIGRATION_FAILED": {
      "retryable": false,
      "fatal": true,
      "message": "Database migration failed"
    },
    "E_VALIDATION": {
      "retryable": false,
      "message": "Request payload failed validation"
    },
    "E_NOT_FOUND": {
      "retryable": false,
      "message": "Resource was not found"
    },
    "E_UNAUTHORIZED": {
      "retryable": false,
      "message": "Authentication required"
    },
    "E_FORBIDDEN": {
      "retryable": false,
      "message": "Insufficient permissions"
