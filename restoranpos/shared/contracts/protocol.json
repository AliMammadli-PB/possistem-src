    "reports.salesSummary": {
      "auth": true
    },
    "$comment.period": "Takings between two instants on the payment clock, plus local-time hour/day buckets. Drives both the period receipt and the dashboard's hourly view; salesSummary is left alone because it mixes payment time with order-opened time and changing it would move numbers people already read.",
    "reports.period": {
      "auth": true,
      "perm": "reports.view",
      "timeout": 10000
    },
    "$comment.remotePeriod": "The same takings query, for a report the owner asked for over WhatsApp. auth:false because the relay runs in Electron main as whoever happens to be signed in at the till - and reports.view belongs to supervisors and up, so an owner's own report would fail for the hours a cashier is on shift. Safe to leave ungated because it answers with money aggregates for a window and nothing else: no names, no order lines, no way to write. Kept separate from reports.period so relaxing this cannot relax the report page the operators use.",
    "reports.remotePeriod": {
      "auth": false,
      "timeout": 15000
    },
    "$comment.reports": "X/Z drain the print queue inline, so these need the print budget (printTimeoutMs) plus room, not defaultTimeoutMs. At 3s a slow printer timed out the IPC call while the report itself had already been committed - and the owner's WhatsApp alert, which hangs off a successful result, never fired.",
    "reports.x": {
      "auth": true,
      "perm": "reports.x",
      "idempotent": true,
