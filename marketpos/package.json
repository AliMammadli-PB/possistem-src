{
  "name": "marketpos",
  "productName": "MarketPos",
  "private": true,
  "version": "1.4.12",
  "description": "Offline-first retail market POS (AZ/RU/EN)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:core": "cmake --build native/build --config Release",
    "test:core": "ctest --test-dir native/build --output-on-failure",
    "test:sync": "node scripts/test-market-sync-resilience.mjs",
    "test": "npm run typecheck && npm run test:core && npm run test:sync",
    "package:win": "npm --prefix ../restoranpos run market:package:win"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/montserrat": "5.3.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "^43.7.5",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  }
}
