{
  "name": "@milioner/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "node dist/seed.js",
    "seed:dev": "tsx src/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "tsx --test src/smoke.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^10.2.1",
    "@hapi/boom": "^10.0.1",
    "@milioner/contracts": "workspace:*",
    "@milioner/database": "workspace:*",
    "@milioner/security": "workspace:*",
    "@whiskeysockets/baileys": "6.7.22",
    "dotenv": "^16.4.7",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.2",
    "fastify-plugin": "^5.0.1",
    "imapflow": "^2.9.1",
    "mailparser": "^3.12.4",
    "mysql2": "^3.23.2",
    "nodemailer": "10.0.6",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "resend": "^6.24.0",
    "sharp": "0.35.5",
    "web-push": "^3.6.7",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
