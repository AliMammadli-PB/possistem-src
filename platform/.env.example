# Never use example secrets in production. Keep real values outside Git.
NODE_ENV=development
DATABASE_URL=postgresql://possistem:CHANGE_ME@127.0.0.1:5432/possistem
SESSION_SECRET=GENERATE_A_RANDOM_SECRET
ACTIVATION_PEPPER=GENERATE_A_DIFFERENT_RANDOM_SECRET
COOKIE_SECURE=true
# Epoint is disabled until merchant keys and bank verification are complete.
EPOINT_PUBLIC_KEY=
EPOINT_PRIVATE_KEY=
# 32 random bytes, encoded as 64 hex characters. Back up separately; do not rotate casually.
EPOINT_TOKEN_ENCRYPTION_KEY=
EPOINT_LIVE_VERIFIED=false
