{
  "name": "milioner-pos-control",
  "private": true,
  "version": "0.1.0",
  "description": "Millioner POS central control platform",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @milioner/api --filter @milioner/admin-web --filter @milioner/reseller-web run dev",
    "dev:api": "pnpm --filter @milioner/api dev",
    "dev:web": "pnpm --filter @milioner/admin-web dev",
    "dev:bayi": "pnpm --filter @milioner/reseller-web dev",
    "dev:portal-mock": "node scripts/mock-customer-portal.mjs",
    "deploy:site": "node scripts/deploy-site.mjs",
    "build": "pnpm -r run build",
    "build:packages": "pnpm --filter @milioner/contracts --filter @milioner/database --filter @milioner/security run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm run build:packages && pnpm -r run typecheck",
    "test": "pnpm run build:packages && pnpm -r run test",
    "migrate": "pnpm --filter @milioner/database migrate",
    "seed": "pnpm --filter @milioner/api seed",
    "db:migrate": "pnpm migrate",
    "db:seed": "pnpm seed"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^8.57.1",
    "ssh2": "^1.17.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "drizzle-orm": "0.45.2",
      "axios": "1.20.0",
      "follow-redirects": "1.16.1",
      "music-metadata": "11.16.0",
      "fast-uri@3": "3.1.9",
      "fast-uri@4": "4.2.3",
      "js-yaml": "4.3.2",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@4": "5.0.11",
      "fastify": "5.12.6",
      "nodemailer": "10.1.4",
      "@fastify/busboy": "3.2.2",
      "shell-quote": "1.11.0",
      "uuid": "11.1.1",
      "react-router": "7.18.2",
      "react-router-dom": "7.18.2"
    }
  }
}
